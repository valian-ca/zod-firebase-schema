{
  "name": "zod-firebase-schema",
  "private": true,
  "description": "zod firebase schema",
  "author": {
    "name": "Valian",
    "url": "https://valian.ca",
    "organization": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/valian-ca/zod-firebase-schema.git"
  },
  "keywords": [
    "zod",
    "firebase",
    "firebase-admin"
  ],
  "version": "1.4.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "eslint": "eslint .",
    "prettier": "prettier --check .",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "lint:publint": "nx run-many --target lint:publint",
    "prepare": "husky",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "type-check": "nx run-many -t type-check",
    "test:integration:ci": "nx run-many -t test:integration:ci --parallel=false"
  },
  "devDependencies": {
    "@commitlint/cli": "20.3.0",
    "@commitlint/config-conventional": "20.3.0",
    "@lerna-lite/cli": "5.6.1",
    "@lerna-lite/publish": "5.6.1",
    "@nx/js": "23.2.0",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.2",
    "@swc/helpers": "0.5.23",
    "@tsconfig/node24": "24.0.5",
    "@valian/eslint-config": "2.0.7",
    "@vitest/coverage-v8": "4.0.16",
    "eslint": "9.39.2",
    "firebase": "12.7.0",
    "firebase-admin": "13.6.0",
    "firebase-functions-test": "3.5.0",
    "firebase-tools": "15.29.0",
    "husky": "9.1.7",
    "markdownlint-cli2": "0.23.2",
    "nx": "22.3.3",
    "prettier": "3.7.4",
    "publint": "0.3.24",
    "ts-essentials": "10.2.1",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "4.0.16",
    "zod": "4.3.5"
  },
  "engines": {
    "node": ">= 22.0.0"
  },
  "packageManager": "pnpm@10.27.0"
}
